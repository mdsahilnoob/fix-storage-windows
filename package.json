{
  "name": "fix-storage-windows",
  "version": "0.1.0",
  "description": "Read-only Windows 10 and 11 storage analysis with cleanup recommendations; no files are modified.",
  "keywords": [
    "windows",
    "windows-10",
    "windows-11",
    "disk",
    "storage",
    "disk-usage",
    "read-only",
    "recommendations",
    "cache",
    "tui",
    "terminal",
    "cli"
  ],
  "homepage": "https://github.com/mdsahilnoob/fix-storage-windows#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdsahilnoob/fix-storage-windows.git"
  },
  "bugs": {
    "url": "https://github.com/mdsahilnoob/fix-storage-windows/issues"
  },
  "license": "MIT",
  "author": "the fix-storage authors",
  "main": "dist/main-windows.js",
  "bin": {
    "fix-storage": "bin/fix-storage.cjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "WINDOWS.md",
    "docs",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsc -p tsconfig.json && node bin/fix-storage.cjs",
    "demo": "tsc -p tsconfig.json && node bin/fix-storage.cjs --demo",
    "plain": "tsc -p tsconfig.json && node bin/fix-storage.cjs --plain",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "bench:scanner": "bun bench/scanner-bench.ts",
    "bench:compare": "bun bench/compare-scanners.ts",
    "bench:compare:optimized": "bun bench/compare-optimized.ts",
    "bench:end-to-end": "bun bench/end-to-end.ts",
    "scanner:reference": "bun tools/scanner-reference.ts",
    "scanner:diff": "node tools/scanner-differential.mjs",
    "check:readonly": "node tools/check-readonly.cjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ink": "^5.2.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.0",
    "acorn": "^8.19.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ]
}
